# Copie para .env (cp .env.example .env) e ajuste os valores. O arquivo .env NÃO é versionado.

# Banco de dados PostgreSQL
DB_USERNAME=oficina
DB_PASSWORD=troque-esta-senha

# Chave HMAC do JWT (mínimo 32 caracteres). Gere uma com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRACAO_MINUTOS=60

# Usuário administrador criado na primeira inicialização
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-admin

# Porta do PostgreSQL exposta no host (mude se a 5432 já estiver em uso)
DB_PORTA_HOST=5432
